---
import Base from "../layouts/Base.astro";

const title = "Starlink Ghana — Power, data and network in one place";
const description = "Understand your Starlink electricity cost in Ghana, track dish energy and see which devices use your data.";
---

<Base title={title} description={description}>
  <link slot="head" rel="stylesheet" href="/dashboard.css" />
  <div class="ghana-app">
    <aside class="side-rail">
      <a class="brand" href="/" aria-label="Starlink Ghana home">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M20 3.5 24 15l12 1-9.2 7.6 3.2 11.7L20 29l-10 6.3 3.2-11.7L4 16l12-1z" fill="currentColor"/><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".4"/></svg></span>
        <span><strong>STARLINK</strong><small>GHANA MONITOR</small></span>
      </a>
      <div class="rail-label">YOUR NETWORK</div>
      <nav class="rail-nav" aria-label="Main navigation">
        <a class="active" aria-current="location" href="#overview"><span class="nav-glyph" aria-hidden="true">◈</span> Overview</a>
        <a href="#power"><span class="nav-glyph">ϟ</span> Power & cost</a>
        <a href="#data"><span class="nav-glyph">⌁</span> Data usage</a>
        <a href="#connection"><span class="nav-glyph">⌘</span> Connection</a>
      </nav>
      <div class="rail-bottom">
        <div class="rail-country"><span class="flag"><i></i><i></i><i></i></span><span>Built for Ghana<br/><b>GH₵ · ECG tariffs</b></span></div>
        <a class="rail-help" href="#how-it-works">How it works <span>↗</span></a>
      </div>
    </aside>

    <main class="workspace">
      <header class="topbar">
        <div class="mobile-brand"><span class="brand-mark small">✳</span><strong>STARLINK GHANA</strong></div>
        <div class="crumbs"><span>My network</span><b>/</b><strong>Overview</strong></div>
        <div class="top-actions"><span class="privacy-pill"><span class="privacy-dot"></span> Data stays on your devices</span><button class="icon-btn" id="install-app" hidden aria-label="Install app">↓</button><button class="icon-btn" id="refresh-data" aria-label="Refresh local collector readings" title="Refresh local collector readings">↻</button><span id="refresh-status" class="sr-only" role="status" aria-live="polite"></span></div>
      </header>

      <div class="content">
        <section id="overview" class="welcome-row">
          <div><div class="eyebrow"><span class="live-dot"></span><span id="connection-label">NOT CONNECTED</span><span class="eyebrow-divider">·</span><span id="local-clock">GHANA TIME</span></div>
          <h1>Know what your<br class="mobile-only"/> <em>Starlink costs.</em></h1>
          <p class="welcome-copy">Estimate your monthly electricity bill in cedis, compare internet costs and see what changes when your setup changes.</p></div>
          <button class="connect-button" data-scroll="power"><span class="connect-icon" aria-hidden="true">→</span> Calculate my cost</button>
        </section>

        <section class="connection-strip" id="connection-strip">
          <div class="strip-icon">⌁</div><div class="strip-copy"><strong>Works without connecting a device.</strong><span>Start with an estimate. Live usage and device readings require a local monitor.</span></div>
          <button class="text-button" data-open-connect>How to get live readings <span aria-hidden="true">→</span></button>
        </section>

        <section class="metrics-grid" aria-label="Network summary">
          <article class="metric-card cost-card">
            <div class="metric-head"><span class="metric-label">ESTIMATED ELECTRICITY</span><span class="metric-icon amber">ϟ</span></div>
            <div class="metric-main"><span class="currency">GH₵</span><strong id="month-cost">—</strong><span class="metric-suffix">/ month</span></div>
            <div class="metric-note"><span id="month-energy">— kWh</span> estimated monthly energy <span class="note-sep">·</span> <span id="rate-label">ECG residential</span></div>
            <div class="metric-footer"><span class="range-pill" id="cost-range">Estimate</span><button class="micro-link" data-scroll="power">Adjust estimate ↗</button></div>
          </article>
          <article class="metric-card">
            <div class="metric-head"><span class="metric-label">DISH POWER DRAW</span><span class="metric-icon green">ϟ</span></div>
            <div class="metric-main"><strong id="watts-now">—</strong><span class="metric-suffix">W <span id="watts-mode">model average</span></span></div>
            <p class="metric-note" id="power-note">Based on your selected model. Live draw appears with a local collector.</p>
            <div class="metric-footer"><span class="range-pill muted" id="model-range">Starlink Mini · 25–40 W</span><button class="micro-link" data-scroll="power">Change dish ↗</button></div>
          </article>
          <article class="metric-card">
            <div class="metric-head"><span class="metric-label">MONTHLY DATA</span><span class="metric-icon blue">⌁</span></div>
            <div class="metric-main"><strong id="data-total">—</strong><span class="metric-suffix">this month</span></div>
            <div class="data-meter"><span id="data-meter-fill"></span></div>
            <div class="metric-footer"><span class="subtle-label" id="data-footnote">Add monthly GB below, or connect a monitor</span><button class="micro-link" data-scroll="data">See devices ↗</button></div>
          </article>
        </section>

        <section class="section-grid" id="power">
          <article class="panel power-panel">
            <div class="panel-heading"><div><div class="eyebrow">GHANA · ECG · GH₵</div><h2>What it costs to run</h2></div><div class="mode-toggle" role="group" aria-label="Cost period"><button type="button" class="period active" aria-pressed="true" data-period="today">Today</button><button type="button" class="period" aria-pressed="false" data-period="week">7 days</button><button type="button" class="period" aria-pressed="false" data-period="month">This month</button></div></div>
            <div class="cost-summary"><div><span class="muted-label">ESTIMATED DISH COST</span><div class="big-cost"><span>GH₵</span><strong id="selected-cost">0.00</strong></div><div class="muted-label" id="selected-period">per day · based on your setup</div></div><div class="energy-stat"><span class="energy-orb">ϟ</span><div><strong id="selected-kwh">0.78 kWh</strong><small id="selected-energy-label">energy used per day</small></div></div></div>
            <div class="bar-visual"><div class="bar-top"><span>Energy history</span><span id="chart-caption">modelled · not measured</span></div><div class="bars" id="cost-bars" aria-label="Estimated cost comparison"></div><div class="bar-labels"><span>History excludes missing readings</span><span id="coverage-label">No history yet</span></div></div>
            <div class="estimate-caption"><span class="info-dot">i</span><span id="estimate-explain">Estimate based on the selected dish’s typical wattage and your ECG tariff. Connect a local collector to replace the model with measured energy.</span></div>
          </article>
          <article class="panel setup-panel">
            <div class="panel-heading"><div><div class="eyebrow">PERSONALISE YOUR ESTIMATE</div><h2>Your setup</h2></div><span class="setup-step">SAVED LOCALLY</span></div>
            <div class="field"><label for="dish-model">Which Starlink dish do you have?</label><select id="dish-model"><option value="mini">Starlink Mini</option><option value="standard4">Standard (Gen 4)</option><option value="standard5">Standard (Gen 5)</option><option value="custom">I know my average watts</option></select><small id="dish-help">Choose Mini or Standard for an estimate. Connected energy uses measured watts regardless of this choice.</small></div>
            <div class="field" id="custom-field" hidden><label for="custom-watts">Average power draw</label><div class="input-wrap"><input id="custom-watts" type="number" min="1" max="500" value="50" inputmode="decimal"/><span>watts</span></div></div>
            <div class="field"><label for="hours">Hours on per day <b id="hours-value">24 hours</b></label><input class="range-input" id="hours" type="range" min="1" max="24" value="24"/><div class="range-labels"><span>1 hour</span><span>24 hours</span></div></div>
            <div class="field"><label for="tariff">ECG electricity rate</label><select id="tariff"><option value="lifeline">Lifeline · household up to 30 kWh</option><option value="residential" selected>Residential · tiered</option><option value="residentialHigh">Residential · already above 300 kWh</option><option value="custom">My own electricity rate</option></select></div>
            <div class="field"><label for="home-use">Other household usage (optional)</label><div class="input-wrap"><input id="home-use" type="number" min="0" max="5000" value="0" inputmode="decimal"/><span>kWh / month</span></div><small>Helps estimate whether dish usage crosses into a higher tariff band.</small></div>
            <div class="field" id="custom-rate-field" hidden><label for="custom-rate">Your electricity rate · GH₵/kWh</label><div class="input-wrap"><input id="custom-rate" type="number" min="0" step="any" value="2.037509"/><span>GH₵/kWh</span></div></div>
            <div class="field"><label for="plan-fee">Monthly Starlink plan fee</label><div class="input-wrap"><input id="plan-fee" type="number" min="0" step="0.01" value="0" inputmode="decimal"/><span>GH₵</span></div><small>Use the amount on your own bill. No plan price is assumed.</small></div>
            <p class="save-status" id="save-status" role="status" aria-live="polite">Changes save automatically on this device.</p>
            <div class="tariff-footnote">ECG energy charges use PURC rates effective 1 Oct 2026. <a href="https://www.purc.com.gh/attachment/545028-20260924090934.pdf" target="_blank" rel="noreferrer">Check PURC tariff decisions ↗</a>. Final bills may include other charges.</div>
          </article>
        </section>

        <section class="section-grid analysis-grid" aria-label="Ghana spending analysis">
          <article class="panel"><div class="eyebrow">YOUR PLAN + ELECTRICITY</div><h2>The cost of your internet</h2>
            <div class="analysis-values"><div><small>Full month estimate</small><strong id="combined-month">—</strong></div><div><small>Effective cost per GB</small><strong id="effective-gb">—</strong></div></div>
            <p class="analysis-note" id="cost-explanation">Enter your plan fee and monthly data to calculate cost per GB.</p>
            <div class="field"><label for="manual-gb">Monthly data used · enter your bill or an estimate</label><div class="input-wrap"><input id="manual-gb" type="number" min="0" step="any" value="0" inputmode="decimal"/><span>GB</span></div><small id="gb-source">Manual entry. The public website does not read your extension’s history.</small></div>
            <div class="field"><label for="cost-budget">Monthly spending target (0 = off)</label><div class="input-wrap"><input id="cost-budget" type="number" min="0" step="any" value="0"/><span>GH₵</span></div></div>
            <progress id="budget-progress" max="100" value="0" aria-label="Estimated spending versus target"></progress><p class="analysis-note" id="budget-note">Set a spending target to see how your estimate compares.</p>
            <div class="field"><label for="people">People sharing your bill</label><div class="input-wrap"><input id="people" type="number" min="1" max="100" step="1" value="1"/><span>people</span></div></div><p class="analysis-note" id="equal-share"></p>
            <button class="save-setup" id="export-report">Download cost report <span>↓</span></button><p id="export-status" class="analysis-note" role="status"></p>
          </article>
          <article class="panel"><div class="eyebrow">TRY A DIFFERENT SETUP</div><h2>Where could you save?</h2>
            <div class="field"><label for="sleep-hours">Hours switched off each day</label><div class="input-wrap"><input id="sleep-hours" type="number" min="0" max="24" value="6"/><span>hours</span></div></div><div class="analysis-values"><div><small>Possible monthly electricity saving</small><strong id="sleep-saving">—</strong></div></div><p class="analysis-note">A model scenario only. Your subscription stays fixed. Switching off means no internet during those hours; this calculator does not change your dish settings.</p>
            <h2 class="compare-heading">Compare a mobile bundle</h2><div class="field"><label for="bundle-price">Current bundle price</label><div class="input-wrap"><input id="bundle-price" type="number" min="0" value="0" step="any"/><span>GH₵</span></div></div><div class="field"><label for="bundle-gb">Bundle size</label><div class="input-wrap"><input id="bundle-gb" type="number" min="0" value="0" step="any"/><span>GB</span></div></div><p class="analysis-note" id="bundle-comparison">Use a current offer from your provider. Bundle expiry, speed and coverage also matter.</p>
          </article>
        </section>

        <section class="section-grid lower-grid" id="data">
          <article class="panel devices-panel">
            <div class="panel-heading"><div><div class="eyebrow">WHO’S USING YOUR DATA?</div><h2>Devices on your network</h2></div><button class="outline-button" data-open-connect>Connect router</button></div>
            <div class="device-empty" id="device-empty"><div class="empty-symbol">⌁</div><strong>Your device list will appear here</strong><p>Connect a local Starlink monitor to see each router-connected device and its share of tracked traffic.</p><button class="text-button" data-open-connect>Connect a monitor <span>→</span></button></div>
            <div id="device-list" class="device-list" hidden></div>
            <div class="device-footer"><span class="dot-hollow"></span> Device totals are router-reported. Shares show the portion of tracked traffic, not the dish’s electricity use.</div>
          </article>
          <article class="panel quick-panel">
            <div class="panel-heading"><div><div class="eyebrow">UNDERSTAND THE NUMBERS</div><h2>Measured or estimated?</h2></div><span class="badge-estimate">ESTIMATE</span></div>
            <div class="signal-rows"><div class="signal-row"><span class="signal-icon measured">◉</span><div><strong>Measured energy</strong><small>Collected from your dish over time</small></div><span class="signal-status" id="energy-status">Not connected</span></div><div class="signal-row"><span class="signal-icon estimated">≈</span><div><strong>Electricity cost</strong><small>Energy multiplied by your ECG rate</small></div><span class="signal-status amber-text" id="cost-status">Modelled</span></div><div class="signal-row"><span class="signal-icon router">⌁</span><div><strong>Per-device data</strong><small>Traffic reported by your Starlink router</small></div><span class="signal-status" id="router-status">Not connected</span></div></div>
            <div class="trust-note"><span>⌑</span><p>Readings stay in the browser and on your own monitor computer. This website does not upload your network history.</p></div>
          </article>
        </section>

        <section class="how-panel" id="how-it-works"><div><div class="eyebrow">DIRECT CONNECTION · NO COLLECTOR SETUP</div><h2>Your data stays yours.</h2><p>Install Starlink Ghana Monitor once in Chrome on a computer connected to your Starlink Wi-Fi. It reads your dish and router directly, and keeps readings on that computer. The website by itself cannot access your home network.</p></div><div class="how-steps"><div><b>01</b><span>Download and install the Starlink Ghana browser extension.</span></div><div><b>02</b><span>Open its dashboard while connected to your Starlink network.</span></div><div><b>03</b><span>Leave Chrome running to keep recording energy and device usage.</span></div></div></section>

        <section class="connect-section" id="connection"><div><div class="eyebrow">LIVE READINGS</div><h2>Connect directly to your dish</h2><p>Install the browser monitor once. It reads Starlink on your local network and records data while Chrome is running.</p></div><button class="connect-button light" data-open-connect>Get the monitor <span>→</span></button></section>
        <section class="panel update-panel" id="updates"><div class="eyebrow">KEEP YOUR MONITOR CURRENT</div><h2>A simpler monitor. An easier update.</h2><p class="analysis-note"><strong>New in v1.4:</strong> Overview, Costs, Devices and Connection screens; guided setup; your actual billing cycle; fair usage comparisons; household device names; optional budget alerts with Ghana quiet hours; and backup previews that merge saved history.</p><p class="analysis-note">Website changes appear when you refresh. For the unpacked extension, download the package below, replace the files inside the same folder you originally loaded, then press Reload on the extension’s card at chrome://extensions. Keep the same folder and extension ID to retain your history. Do not remove the extension.</p><a class="connect-button" href="https://github.com/hayalows/starlink/releases/latest/download/starlink-ghana-monitor-chrome.zip">Download latest Chrome extension ↓</a><a class="text-button" href="https://github.com/hayalows/starlink/releases/latest" target="_blank" rel="noreferrer">Read release notes ↗</a><p class="analysis-note">Export a backup in Overview before updating. The package includes Update-Starlink.ps1 (Windows PowerShell) and Update-Starlink.command (macOS Terminal). Run the helper from your existing installation folder to download, verify and replace the files while keeping a copy of the previous version. Then reload the extension. Chrome Web Store publication is still needed for fully automatic installation updates.</p></section>
        <footer class="app-footer"><span>STARLINK GHANA · INDEPENDENT TOOL</span><span>Not affiliated with or endorsed by SpaceX or Starlink.</span><a href="https://github.com/hayalows/starlink" target="_blank" rel="noreferrer">Open source ↗</a></footer>
      </div>
    </main>

    <nav class="mobile-nav" aria-label="Mobile navigation"><a class="active" aria-current="location" href="#overview"><span aria-hidden="true">◈</span><small>Home</small></a><a href="#power">ϟ<small>Cost</small></a><a href="#data">⌁<small>Data</small></a><a href="#connection">⌘<small>Connect</small></a></nav>

    <dialog id="connect-dialog" class="connect-dialog" aria-labelledby="connect-title" aria-describedby="connect-description"><form method="dialog"><button class="dialog-close" aria-label="Close">×</button></form><div class="eyebrow">DIRECT STARLINK CONNECTION</div><h2 id="connect-title">Use Starlink Ghana Monitor</h2><p class="dialog-intro" id="connect-description">The web page cannot reach your dish on its own. The browser extension runs on your computer and reads the dish and router directly, so there is no collector address to find and no <code>npm run historian</code> setup.</p><a class="connect-button" href="https://github.com/hayalows/starlink/releases/latest/download/starlink-ghana-monitor-chrome.zip">Download Chrome extension <span>↓</span></a><div class="connect-hint"><b>One-time Chrome install</b><span>Unzip the download, open <code>chrome://extensions</code>, turn on Developer mode, choose “Load unpacked”, and select the unzipped folder. Then click the Starlink Ghana Monitor icon to open your dashboard.</span></div><div class="connect-hint"><b>Already installed?</b><span>Replace files in the same loaded folder, then click Reload in chrome://extensions. Keep the folder and extension ID to retain history.</span></div><div class="connect-hint"><b>For live history</b><span>Use Chrome on a computer connected to your Starlink Wi-Fi. The extension reads the dish directly and stores history in your browser. Keep Chrome open to keep collecting.</span></div><details class="connect-hint"><summary>Already run a local monitor?</summary><div class="advanced-collector"><label for="collector-url">Collector address</label><input id="collector-url" type="url" value="http://127.0.0.1:8088" placeholder="https://your-computer.tailnet.ts.net" autocomplete="url"/><label for="collector-token" class="token-label">Access token <span>required for private phone access</span></label><input id="collector-token" type="password" placeholder="Paste your local collector token" autocomplete="off"/><button type="button" class="find-local" id="find-local">Find monitor on this device <span>→</span></button><p class="dialog-error" id="connect-error" role="status"></p><div class="dialog-actions"><button type="button" class="button-quiet" id="disconnect">Disconnect</button><button type="button" class="connect-button" id="test-connection">Test & connect</button></div></div></details><p class="dialog-privacy">The extension reads local Starlink telemetry and router data. It does not send your network history to this website.</p></dialog>
  </div>

  <script src="../scripts/ghana-dashboard.ts"></script>
</Base>
