---
import Base from "../layouts/Base.astro";

const title = "Starlink Ghana — Power, data and network in one place";
const description = "Understand your Starlink electricity cost in Ghana, track dish energy and see which devices use your data.";
---

<Base title={title} description={description}>
  <link slot="head" rel="stylesheet" href="/dashboard.css" />
  <div class="ghana-app">
    <aside class="side-rail">
      <a class="brand" href="/" aria-label="Starlink Ghana home">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M20 3.5 24 15l12 1-9.2 7.6 3.2 11.7L20 29l-10 6.3 3.2-11.7L4 16l12-1z" fill="currentColor"/><circle cx="20" cy="20" r="18" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".4"/></svg></span>
        <span><strong>STARLINK</strong><small>GHANA MONITOR</small></span>
      </a>
      <div class="rail-label">YOUR NETWORK</div>
      <nav class="rail-nav" aria-label="Main navigation">
        <a class="active" href="#overview"><span class="nav-glyph">◈</span> Overview</a>
        <a href="#power"><span class="nav-glyph">ϟ</span> Power & cost</a>
        <a href="#data"><span class="nav-glyph">⌁</span> Data usage</a>
        <a href="#connection"><span class="nav-glyph">⌘</span> Connection</a>
      </nav>
      <div class="rail-bottom">
        <div class="rail-country"><span class="flag"><i></i><i></i><i></i></span><span>Built for Ghana<br/><b>GH₵ · ECG tariffs</b></span></div>
        <a class="rail-help" href="#how-it-works">How it works <span>↗</span></a>
      </div>
    </aside>

    <main class="workspace">
      <header class="topbar">
        <div class="mobile-brand"><span class="brand-mark small">✳</span><strong>STARLINK GHANA</strong></div>
        <div class="crumbs"><span>My network</span><b>/</b><strong>Overview</strong></div>
        <div class="top-actions"><span class="privacy-pill"><span class="privacy-dot"></span> Data stays on your devices</span><button class="icon-btn" id="install-app" hidden aria-label="Install app">↓</button><button class="icon-btn" id="refresh-data" aria-label="Refresh readings">↻</button></div>
      </header>

      <div class="content">
        <section id="overview" class="welcome-row">
          <div><div class="eyebrow"><span class="live-dot"></span><span id="connection-label">NOT CONNECTED</span><span class="eyebrow-divider">·</span><span id="local-clock">GHANA TIME</span></div>
          <h1>Your Starlink,<br class="mobile-only"/> <em>understood.</em></h1>
          <p class="welcome-copy">Know what it costs to run, how your data is shared, and what your dish is doing.</p></div>
          <button class="connect-button" data-open-connect><span class="connect-icon">＋</span> Connect your Starlink</button>
        </section>

        <section class="connection-strip" id="connection-strip">
          <div class="strip-icon">⌁</div><div class="strip-copy"><strong>Your dashboard is ready.</strong><span>Connect the computer collecting your Starlink readings to see live energy and device usage here.</span></div>
          <button class="text-button" data-open-connect>Set up connection <span>→</span></button>
        </section>

        <section class="metrics-grid" aria-label="Network summary">
          <article class="metric-card cost-card">
            <div class="metric-head"><span class="metric-label">ESTIMATED ELECTRICITY</span><span class="metric-icon amber">ϟ</span></div>
            <div class="metric-main"><span class="currency">GH₵</span><strong id="month-cost">—</strong><span class="metric-suffix">/ month</span></div>
            <div class="metric-note"><span id="month-energy">— kWh</span> estimated monthly energy <span class="note-sep">·</span> <span id="rate-label">ECG residential</span></div>
            <div class="metric-footer"><span class="range-pill" id="cost-range">Estimate</span><button class="micro-link" data-scroll="power">Adjust estimate ↗</button></div>
          </article>
          <article class="metric-card">
            <div class="metric-head"><span class="metric-label">DISH POWER DRAW</span><span class="metric-icon green">ϟ</span></div>
            <div class="metric-main"><strong id="watts-now">—</strong><span class="metric-suffix">W <span id="watts-mode">model average</span></span></div>
            <div class="mini-chart" aria-hidden="true"><svg viewBox="0 0 320 40" preserveAspectRatio="none"><path class="chart-fill" d="M0 32 C22 30 26 16 47 19 S72 30 93 24 119 9 141 17 165 28 184 21 208 10 229 18 253 26 272 15 297 18 320 7 L320 40 L0 40Z"/><path class="chart-line" d="M0 32 C22 30 26 16 47 19 S72 30 93 24 119 9 141 17 165 28 184 21 208 10 229 18 253 26 272 15 297 18 320 7"/></svg><span>Preview</span></div>
            <div class="metric-footer"><span class="range-pill muted" id="model-range">Starlink Mini · 25–40 W</span><button class="micro-link" data-scroll="power">Change dish ↗</button></div>
          </article>
          <article class="metric-card">
            <div class="metric-head"><span class="metric-label">HOUSEHOLD DATA</span><span class="metric-icon blue">⌁</span></div>
            <div class="metric-main"><strong id="data-total">—</strong><span class="metric-suffix">this month</span></div>
            <div class="data-meter"><span id="data-meter-fill"></span></div>
            <div class="metric-footer"><span class="subtle-label" id="data-footnote">Waiting for router readings</span><button class="micro-link" data-scroll="data">See devices ↗</button></div>
          </article>
        </section>

        <section class="section-grid" id="power">
          <article class="panel power-panel">
            <div class="panel-heading"><div><div class="eyebrow">GHANA · ECG · GH₵</div><h2>What it costs to run</h2></div><div class="mode-toggle" role="group" aria-label="Cost period"><button class="period active" data-period="day">Day</button><button class="period" data-period="week">Week</button><button class="period" data-period="month">Month</button></div></div>
            <div class="cost-summary"><div><span class="muted-label">ESTIMATED DISH COST</span><div class="big-cost"><span>GH₵</span><strong id="selected-cost">0.00</strong></div><div class="muted-label" id="selected-period">per day · based on your setup</div></div><div class="energy-stat"><span class="energy-orb">ϟ</span><div><strong id="selected-kwh">0.78 kWh</strong><small>energy used per day</small></div></div></div>
            <div class="bar-visual"><div class="bar-top"><span>Daily cost breakdown</span><span id="chart-caption">modelled · not measured</span></div><div class="bars" id="cost-bars" aria-label="Estimated cost comparison"></div><div class="bar-labels"><span>Dish electricity</span><span>30-day estimate</span></div></div>
            <div class="estimate-caption"><span class="info-dot">i</span><span id="estimate-explain">Estimate based on the selected dish’s typical wattage and your ECG tariff. Connect a local collector to replace the model with measured energy.</span></div>
          </article>
          <article class="panel setup-panel">
            <div class="panel-heading"><div><div class="eyebrow">PERSONALISE YOUR ESTIMATE</div><h2>Your setup</h2></div><span class="setup-step">01 / 03</span></div>
            <div class="field"><label for="dish-model">Which Starlink dish do you have?</label><select id="dish-model"><option value="mini">Starlink Mini</option><option value="standard4">Standard (Gen 4)</option><option value="standard5">Standard (Gen 5)</option><option value="custom">I know my average watts</option></select><small id="dish-help">Choose Mini or Standard for an estimate. Connected energy uses measured watts regardless of this choice.</small></div>
            <div class="field" id="custom-field" hidden><label for="custom-watts">Average power draw</label><div class="input-wrap"><input id="custom-watts" type="number" min="1" max="500" value="50" inputmode="decimal"/><span>watts</span></div></div>
            <div class="field"><label for="hours">Hours on per day <b id="hours-value">24 hours</b></label><input class="range-input" id="hours" type="range" min="1" max="24" value="24"/><div class="range-labels"><span>1 hour</span><span>24 hours</span></div></div>
            <div class="field"><label for="tariff">ECG electricity rate</label><select id="tariff"><option value="lifeline">Lifeline · 0–30 kWh</option><option value="residential" selected>Residential · 0–300 kWh</option><option value="residential-high">Residential · above 300 kWh</option></select></div>
            <div class="field"><label for="home-use">Your home uses (optional)</label><div class="input-wrap"><input id="home-use" type="number" min="0" max="5000" value="180" inputmode="decimal"/><span>kWh / month</span></div><small>Helps estimate whether dish usage crosses into a higher tariff band.</small></div>
            <button class="save-setup" id="save-setup">Save my setup <span>→</span></button>
            <div class="tariff-footnote">ECG energy charges use PURC rates effective 1 Oct 2026. <a href="https://webmail.purc.com.gh/categ/tariffs/subcategories/tariff-decision-papers" target="_blank" rel="noreferrer">Check PURC tariff decisions ↗</a>. Final bills may include other charges.</div>
          </article>
        </section>

        <section class="section-grid lower-grid" id="data">
          <article class="panel devices-panel">
            <div class="panel-heading"><div><div class="eyebrow">WHO’S USING YOUR DATA?</div><h2>Devices on your network</h2></div><button class="outline-button" data-open-connect>Connect router</button></div>
            <div class="device-empty" id="device-empty"><div class="empty-symbol">⌁</div><strong>Your device list will appear here</strong><p>Connect a local Starlink monitor to see each router-connected device and its share of tracked traffic.</p><button class="text-button" data-open-connect>Connect a monitor <span>→</span></button></div>
            <div id="device-list" class="device-list" hidden></div>
            <div class="device-footer"><span class="dot-hollow"></span> Device totals are router-reported. Shares show the portion of tracked traffic, not the dish’s electricity use.</div>
          </article>
          <article class="panel quick-panel">
            <div class="panel-heading"><div><div class="eyebrow">UNDERSTAND THE NUMBERS</div><h2>Measured or estimated?</h2></div><span class="badge-estimate">ESTIMATE</span></div>
            <div class="signal-rows"><div class="signal-row"><span class="signal-icon measured">◉</span><div><strong>Measured energy</strong><small>Collected from your dish over time</small></div><span class="signal-status" id="energy-status">Not connected</span></div><div class="signal-row"><span class="signal-icon estimated">≈</span><div><strong>Electricity cost</strong><small>Energy multiplied by your ECG rate</small></div><span class="signal-status amber-text" id="cost-status">Modelled</span></div><div class="signal-row"><span class="signal-icon router">⌁</span><div><strong>Per-device data</strong><small>Traffic reported by your Starlink router</small></div><span class="signal-status" id="router-status">Not connected</span></div></div>
            <div class="trust-note"><span>⌑</span><p>Readings stay in the browser and on your own monitor computer. This website does not upload your network history.</p></div>
          </article>
        </section>

        <section class="how-panel" id="how-it-works"><div><div class="eyebrow">LOCAL-FIRST · NO STARLINK LOGIN</div><h2>Your data stays yours.</h2><p>The web app is hosted publicly, but it only reads household readings from the local collector address you provide. Nothing is sent to a Starlink account or synced to our servers.</p></div><div class="how-steps"><div><b>01</b><span>Run the monitor on a computer connected to your Starlink network.</span></div><div><b>02</b><span>Enter its private collector address here. The browser connects directly.</span></div><div><b>03</b><span>Install this dashboard on your phone for quick access.</span></div></div></section>

        <section class="connect-section" id="connection"><div><div class="eyebrow">LIVE READINGS</div><h2>Connect your home monitor</h2><p>Pair this dashboard with the Dishylink monitor running on a computer at home. Your readings remain local to your network.</p></div><button class="connect-button light" data-open-connect>Set up connection <span>→</span></button></section>
        <footer class="app-footer"><span>STARLINK GHANA · INDEPENDENT TOOL</span><span>Not affiliated with or endorsed by SpaceX or Starlink.</span><a href="https://github.com/hayalows/starlink" target="_blank" rel="noreferrer">Open source ↗</a></footer>
      </div>
    </main>

    <nav class="mobile-nav" aria-label="Mobile navigation"><a class="active" href="#overview">◈<small>Home</small></a><a href="#power">ϟ<small>Cost</small></a><a href="#data">⌁<small>Data</small></a><a href="#connection">⌘<small>Connect</small></a></nav>

    <dialog id="connect-dialog" class="connect-dialog"><form method="dialog"><button class="dialog-close" aria-label="Close">×</button></form><div class="eyebrow">LOCAL CONNECTION · READ ONLY</div><h2>Connect your Starlink monitor</h2><p class="dialog-intro">Enter the address of the collector on your home computer. The browser will request permission to read its local network data.</p><label for="collector-url">Collector address</label><input id="collector-url" type="url" placeholder="http://127.0.0.1:8088" autocomplete="url"/><label for="collector-token" class="token-label">Access token <span>required for private phone access</span></label><input id="collector-token" type="password" placeholder="Paste your local collector token" autocomplete="off"/><div class="connect-hint"><b>On this computer</b><span>Use <code>http://127.0.0.1:8088</code> if the monitor runs here.</span></div><div class="connect-hint"><b>From your phone</b><span>Your monitor must be reachable over HTTPS (for example through your private Tailscale network). A phone cannot use its own 127.0.0.1 to reach your computer.</span></div><p class="dialog-error" id="connect-error" role="status"></p><div class="dialog-actions"><button type="button" class="button-quiet" id="disconnect">Disconnect</button><button type="button" class="connect-button" id="test-connection">Test & connect</button></div><p class="dialog-privacy">Only read-only dashboard endpoints are requested. The saved address stays in this browser’s local storage.</p></dialog>
  </div>

  <script is:inline>
    (function () {
      var tariffs = { lifeline: 0.899315, residential: 2.037509, "residential-high": 2.692235 };
      var models = {
        mini: { label: "Starlink Mini", min: 25, max: 40, watts: 32.5 },
        standard4: { label: "Standard Gen 4", min: 75, max: 100, watts: 87.5 },
        standard5: { label: "Standard Gen 5", min: 35, max: 50, watts: 42.5 },
        custom: { label: "Custom dish", min: 1, max: 500, watts: 50 },
      };
      var settings = { model: "mini", hours: 24, tariff: "residential", homeKwh: 180, customWatts: 50, period: "day" };
      var connected = false, installPrompt = null, readings = null, authToken = "";
      var $ = function (id) { return document.getElementById(id); };
      var money = new Intl.NumberFormat("en-GH", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      function currency(v) { return money.format(Math.max(0, v)); }
      function modelNow() { return settings.model === "custom" ? Object.assign({}, models.custom, { watts: settings.customWatts }) : models[settings.model]; }
      function marginalCost(kwh) {
        var base = Math.max(0, Number(settings.homeKwh) || 0);
        var after = base + kwh;
        if (settings.tariff === "lifeline") return kwh * tariffs.lifeline;
        if (settings.tariff === "residential-high") return kwh * tariffs["residential-high"];
        var cost = function (units) { return Math.min(units, 300) * tariffs.residential + Math.max(0, units - 300) * tariffs["residential-high"]; };
        return cost(after) - cost(base);
      }
      function recalc() {
        var m = modelNow(), dayKwh = m.watts * settings.hours / 1000;
        var days = settings.period === "day" ? 1 : settings.period === "week" ? 7 : 30;
        var actualRange = readings && readings.energyByRange && readings.energyByRange[settings.period];
        var measuredKwh = actualRange && actualRange.coverage && actualRange.coverage.fraction >= 0.5 ? actualRange.totalKWh : null;
        var kwh = measuredKwh !== null ? measuredKwh : dayKwh * days;
        var cost = marginalCost(kwh);
        $("watts-now").textContent = readings && Number.isFinite(readings.powerW) ? readings.powerW.toFixed(1) : m.watts.toFixed(1);
        $("watts-mode").textContent = readings ? "live draw" : "W average";
        $("model-range").textContent = m.label + " · " + m.min + "–" + m.max + " W";
        var measuredMonth = readings && readings.energyByRange && readings.energyByRange.month;
        var monthKwh = measuredMonth && measuredMonth.coverage && measuredMonth.coverage.fraction >= 0.5 ? measuredMonth.totalKWh : dayKwh * 30;
        $("month-cost").textContent = currency(marginalCost(monthKwh));
        $("month-energy").textContent = monthKwh.toFixed(1) + " kWh";
        $("rate-label").textContent = settings.tariff === "lifeline" ? "ECG lifeline" : "ECG residential";
        $("selected-cost").textContent = currency(cost);
        $("selected-kwh").textContent = kwh.toFixed(2) + " kWh";
        $("selected-period").textContent = "per " + settings.period + " · " + (readings ? "using measured energy" : "based on your setup");
        $("chart-caption").textContent = readings ? "measured · collector" : "modelled · not measured";
        $("cost-range").textContent = readings ? "Live energy" : "Estimate";
        $("cost-range").classList.toggle("live", !!readings);
        $("estimate-explain").textContent = readings ? "Energy uses samples recorded by your local monitor. The cedi amount applies your selected ECG rate and is an estimate of the dish’s incremental energy charge." : "Estimate uses the selected dish’s typical wattage and your ECG tariff. The cost is incremental and can reflect your home’s selected residential tariff band.";
        $("hours-value").textContent = settings.hours + (settings.hours === 1 ? " hour" : " hours");
        $("hours").value = settings.hours;
        $("dish-model").value = settings.model;
        $("tariff").value = settings.tariff;
        $("home-use").value = settings.homeKwh;
        $("custom-watts").value = settings.customWatts;
        $("custom-field").hidden = settings.model !== "custom";
        $("data-total").textContent = readings && readings.dataGB ? readings.dataGB.toFixed(1) + " GB" : "—";
        $("data-footnote").textContent = readings && readings.deviceRows ? readings.deviceRows.length + " devices tracked this month" : "Waiting for router readings";
        $("data-meter-fill").style.width = readings ? Math.min(100, Math.max(8, readings.dataGB || 0)) + "%" : "0%";
        $("energy-status").textContent = readings ? "Live samples" : "Not connected";
        $("router-status").textContent = readings && readings.deviceRows ? "Live totals" : "Not connected";
        $("cost-status").textContent = readings ? "Measured kWh" : "Modelled";
        $("connection-label").textContent = connected ? "COLLECTOR CONNECTED" : "NOT CONNECTED";
        $("connection-strip").classList.toggle("connected", connected);
        if (connected) $("connection-strip").querySelector(".strip-copy").innerHTML = "<strong>Local monitor connected.</strong><span>Energy history and router-reported device totals are being read from your collector.</span>";
        renderBars();
      }
      function renderBars() {
        var days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
        var val = modelNow().watts * settings.hours / 1000 * tariffs[settings.tariff];
        var host = $("cost-bars");
        host.innerHTML = "";
        days.forEach(function (day, i) {
          var h = Math.max(24, Math.min(68, (val / (val + 2)) * 80));
          var bar = document.createElement("span");
          bar.className = "bar" + (i === 6 ? " today" : "");
          bar.style.height = h + "%";
          bar.title = "Illustrative daily estimate · GH₵" + currency(val);
          host.appendChild(bar);
        });
        host.setAttribute("aria-label", "Estimated daily electricity cost repeated across days; no historical readings shown");
      }
      function save() {
        try { localStorage.setItem("starlinkGhanaSettings", JSON.stringify(settings)); } catch (_) {}
        recalc();
      }
      function load() {
        try {
          var saved = JSON.parse(localStorage.getItem("starlinkGhanaSettings") || "{}");
          settings = Object.assign(settings, saved);
        } catch (_) {}
      }
      function normalizeBase(url) { return url.replace(/\/+$/, ""); }
      async function getJson(url) {
        var opts = { cache: "no-store", headers: authToken ? { "Authorization": "Bearer " + authToken } : {} };
        if (url.startsWith("http://") && window.isSecureContext && "targetAddressSpace" in Request.prototype) opts.targetAddressSpace = "local";
        var response = await fetch(url, opts);
        if (!response.ok) throw new Error("Collector returned " + response.status);
        return response.json();
      }
      async function connect(base, token) {
        authToken = token || authToken || "";
        var root = normalizeBase(base);
        var health = await getJson(root + "/api/health");
        if (!health || health.ok !== true) throw new Error("The address responded, but it is not a Starlink monitor collector.");
        var result = await Promise.allSettled([getJson(root + "/api/energy?range=day"), getJson(root + "/api/energy?range=week"), getJson(root + "/api/energy?range=month"), getJson(root + "/api/samples?minutes=15"), getJson(root + "/api/clients/totals")]);
        var energyByRange = { day: result[0].status === "fulfilled" ? result[0].value : null, week: result[1].status === "fulfilled" ? result[1].value : null, month: result[2].status === "fulfilled" ? result[2].value : null };
        var energy = energyByRange.month;
        var sample = result[3].status === "fulfilled" ? (result[3].value.samples || []).slice(-1)[0] : null;
        var clients = result[4].status === "fulfilled" ? result[4].value : null;
        readings = { powerW: sample && Number(sample.powerW), energy, energyByRange, dataGB: energy && Number(energy.totalDownGB || 0) + Number(energy.totalUpGB || 0), deviceRows: clients && clients.totals || [] };
        if (clients && Array.isArray(clients.totals)) {
          readings.deviceRows = clients.totals;
          readings.dataGB = clients.totals.reduce(function (sum, row) { return sum + ((Number(row.rxBytes || 0) + Number(row.txBytes || 0) + Number(row.monthBytes || row.bytes || row.totalBytes || 0)) / 1e9); }, 0);
        }
        connected = true;
        localStorage.setItem("starlinkGhanaCollector", root);
        if (authToken) localStorage.setItem("starlinkGhanaToken", authToken); else localStorage.removeItem("starlinkGhanaToken");
        $("connect-dialog").close();
        $("connection-strip").querySelector(".strip-copy").innerHTML = "<strong>Local monitor connected.</strong><span>Latest sampled dish energy and router device totals are available on this device.</span>";
        $("connection-strip").classList.add("connected");
        renderDevices(readings.deviceRows);
        recalc();
      }
      function renderDevices(rows) {
        var list = $("device-list"), empty = $("device-empty");
        list.innerHTML = "";
        if (!rows || !rows.length) { list.hidden = true; empty.hidden = false; return; }
        empty.hidden = true; list.hidden = false;
        var total = rows.reduce(function (s, r) { return s + Number(r.rxBytes || 0) + Number(r.txBytes || 0) + Number(r.monthBytes || r.bytes || r.totalBytes || 0); }, 0);
        rows.slice().sort(function(a,b){return (Number(b.rxBytes||0)+Number(b.txBytes||0)+Number(b.monthBytes||b.bytes||b.totalBytes||0))-(Number(a.rxBytes||0)+Number(a.txBytes||0)+Number(a.monthBytes||a.bytes||a.totalBytes||0))}).forEach(function(row) {
          var bytes = Number(row.rxBytes||0)+Number(row.txBytes||0)+Number(row.monthBytes || row.bytes || row.totalBytes || 0), pct = total ? bytes / total * 100 : 0;
          var line = document.createElement("div"); line.className = "device-row";
          var name = document.createElement("strong"); name.textContent = row.name || row.nickname || row.hostname || "Unknown device";
          var size = document.createElement("span"); size.textContent = bytes >= 1e9 ? (bytes/1e9).toFixed(2)+" GB" : (bytes/1e6).toFixed(0)+" MB";
          var meta = document.createElement("small"); meta.textContent = pct.toFixed(1)+"% of tracked traffic";
          var track = document.createElement("div"); track.className = "device-track"; var fill = document.createElement("i"); fill.style.width = pct+"%"; track.appendChild(fill);
          line.append(name,size,meta,track); list.appendChild(line);
        });
      }
      document.querySelectorAll("[data-period]").forEach(function (b) { b.addEventListener("click", function () { settings.period=b.dataset.period; document.querySelectorAll("[data-period]").forEach(function(x){x.classList.toggle("active",x===b)}); recalc(); }); });
      ["dish-model","hours","tariff","home-use","custom-watts"].forEach(function(id){ $(id).addEventListener("input",function(){ if(id==="dish-model") settings.model=this.value; if(id==="hours") settings.hours=Number(this.value); if(id==="tariff") settings.tariff=this.value; if(id==="home-use") settings.homeKwh=Number(this.value)||0; if(id==="custom-watts") settings.customWatts=Number(this.value)||50; save(); }); });
      document.querySelectorAll("[data-open-connect]").forEach(function(b){b.addEventListener("click",function(){ $("connect-dialog").showModal(); });});
      document.querySelectorAll("[data-scroll]").forEach(function(b){b.addEventListener("click",function(){document.getElementById(b.dataset.scroll).scrollIntoView({behavior:"smooth"});});});
      $("test-connection").addEventListener("click", async function(){ var input=$("collector-url").value.trim(); var token=$("collector-token").value.trim(); if(!input) { $("connect-error").textContent="Enter a collector address first."; return; } $("connect-error").textContent="Checking local collector…"; try { await connect(input,token); } catch(e) { $("connect-error").textContent="Could not connect. Check the address, that the monitor is running, and your browser’s local network permission."; } });
      $("disconnect").addEventListener("click",function(){ localStorage.removeItem("starlinkGhanaCollector"); localStorage.removeItem("starlinkGhanaToken"); authToken=""; readings=null; connected=false; renderDevices([]); $("connect-dialog").close(); recalc(); });
      $("refresh-data").addEventListener("click",async function(){ var base=localStorage.getItem("starlinkGhanaCollector"); authToken=localStorage.getItem("starlinkGhanaToken")||""; if(base) try { await connect(base,authToken); } catch(_) { connected=false; readings=null; recalc(); } });
      window.addEventListener("beforeinstallprompt",function(e){e.preventDefault();installPrompt=e;$("install-app").hidden=false;});
      $("install-app").addEventListener("click",async function(){if(installPrompt){installPrompt.prompt();await installPrompt.userChoice;installPrompt=null;}else{alert("On iPhone, open the Share menu in Safari and choose Add to Home Screen.");}});
      document.querySelectorAll(".mobile-nav a").forEach(function(a){a.addEventListener("click",function(){document.querySelectorAll(".mobile-nav a").forEach(function(x){x.classList.toggle("active",x===a)});});});
      $("save-setup").addEventListener("click",save);
      $("save-setup").addEventListener("click",save);
      $("local-clock").textContent = new Intl.DateTimeFormat("en-GH",{timeZone:"Africa/Accra",hour:"2-digit",minute:"2-digit",hour12:false}).format(new Date())+" · ACCRA";
      load(); recalc();
      if ("serviceWorker" in navigator) window.addEventListener("load",function(){navigator.serviceWorker.register("/service-worker.js").catch(function(){});});
      setInterval(function(){
        var base=localStorage.getItem("starlinkGhanaCollector");
        if(base && connected) connect(base,authToken).catch(function(){
          connected=false; readings=null;
          $("connection-strip").classList.remove("connected");
          $("connection-strip").querySelector(".strip-copy").innerHTML="<strong>Monitor temporarily unavailable.</strong><span>Saved estimate is still here. Check that your home monitor and private connection are online.</span>";
          recalc();
        });
      },60000);
      
      var savedCollector=localStorage.getItem("starlinkGhanaCollector");
      if(savedCollector){authToken=localStorage.getItem("starlinkGhanaToken")||"";$("collector-url").value=savedCollector;$("collector-token").value=authToken;connect(savedCollector,authToken).catch(function(){connected=false;readings=null;recalc();});}
    })();
  </script>

