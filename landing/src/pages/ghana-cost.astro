---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";

const title = "Ghana Starlink Cost Calculator — Dishylink";
const description =
  "Estimate Starlink electricity cost in Ghana cedis using current ECG residential rates, and compare Mini and Standard dish power use.";
---

<Base title={title} description={description} path="/ghana-cost/">
  <Nav />

  <main class="relative mx-auto max-w-7xl overflow-hidden px-5 pb-20">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[560px] opacity-40 [background-image:radial-gradient(var(--color-rule-2)_0.5px,transparent_0.5px)] [background-size:22px_22px]"
      aria-hidden="true"
    ></div>

    <section class="relative pt-14 pb-10 sm:pt-20">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-rule bg-surface px-3 py-1.5 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] text-ink-2">
          <span class="size-1.5 rounded-full bg-warm"></span>
          Ghana · ECG · GH₵
        </div>
        <h1 class="mt-6 font-display text-display font-medium text-ink">
          What will Starlink add to your electricity cost?
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-2 sm:text-xl">
          Pick your dish, choose your ECG rate band, and see a simple daily, weekly and monthly estimate.
          When Dishylink is connected, it can use your measured energy instead.
        </p>
      </div>
    </section>

    <section class="grid gap-4 lg:grid-cols-[1.02fr_0.98fr]" aria-label="Starlink electricity calculator">
      <form id="ghana-cost-form" class="rounded-[22px] border border-rule bg-paper p-5 shadow-[0_22px_70px_-45px_rgb(0_0_0/0.3)] sm:p-7">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-3">Your setup</div>
            <h2 class="mt-1 text-2xl font-bold tracking-tight">Start with the dish</h2>
          </div>
          <div class="rounded-full bg-surface px-2.5 py-1 font-mono text-[10px] text-ink-2">24/7 default</div>
        </div>

        <label for="dish-model" class="mt-6 block text-sm font-semibold">Dish model</label>
        <select id="dish-model" class="mt-2 w-full rounded-xl border border-rule bg-paper px-3.5 py-3 text-base text-ink outline-none transition focus:border-warm focus:ring-2 focus:ring-warm/20">
          <option value="mini">Starlink Mini</option>
          <option value="standard4">Standard 4</option>
          <option value="standard5">Standard V5</option>
          <option value="custom">I know my average watts</option>
        </select>
        <div id="custom-watts-wrap" class="mt-4 hidden">
          <label for="custom-watts" class="block text-sm font-semibold">Average power draw</label>
          <div class="mt-2 flex items-center rounded-xl border border-rule bg-paper px-3.5 focus-within:border-warm focus-within:ring-2 focus-within:ring-warm/20">
            <input id="custom-watts" type="number" min="1" max="500" value="50" inputmode="decimal" class="w-full border-0 bg-transparent py-3 font-mono text-base text-ink outline-none" />
            <span class="font-mono text-sm text-ink-3">watts</span>
          </div>
        </div>
        <div id="model-assumption" class="mt-2 rounded-xl bg-surface px-3.5 py-3 text-sm leading-relaxed text-ink-2" aria-live="polite"></div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div>
            <label for="ecg-rate" class="block text-sm font-semibold">ECG residential rate</label>
            <select id="ecg-rate" class="mt-2 w-full rounded-xl border border-rule bg-paper px-3.5 py-3 text-sm text-ink outline-none focus:border-warm focus:ring-2 focus:ring-warm/20">
              <option value="0.899315">Lifeline · 0–30 kWh</option>
              <option value="2.037509" selected>Residential · 0–300 kWh</option>
              <option value="2.692235">Residential · 301+ kWh</option>
            </select>
          </div>
          <div>
            <label for="hours-per-day" class="block text-sm font-semibold">Powered hours per day</label>
            <div class="mt-2 flex items-center rounded-xl border border-rule bg-paper px-3.5 focus-within:border-warm focus-within:ring-2 focus-within:ring-warm/20">
              <input id="hours-per-day" type="number" min="1" max="24" step="1" value="24" class="w-full border-0 bg-transparent py-3 font-mono text-base text-ink outline-none" />
              <span class="font-mono text-sm text-ink-3">hours</span>
            </div>
          </div>
        </div>

        <label for="plan-fee" class="mt-6 block text-sm font-semibold">
          Starlink monthly plan <span class="font-normal text-ink-3">· optional</span>
        </label>
        <div class="mt-2 flex items-center rounded-xl border border-rule bg-paper px-3.5 focus-within:border-warm focus-within:ring-2 focus-within:ring-warm/20">
          <span class="font-mono text-sm text-ink-3">GH₵</span>
          <input id="plan-fee" type="number" min="0" step="0.01" placeholder="Enter your plan price" class="w-full border-0 bg-transparent px-2 py-3 font-mono text-base text-ink outline-none" />
        </div>
        <p class="mt-2 text-xs leading-relaxed text-ink-3">Enter the price shown in your Starlink account to include your subscription in the monthly total.</p>

        <div class="mt-6 flex items-start gap-2.5 rounded-xl border border-rule bg-surface px-3.5 py-3 text-xs leading-relaxed text-ink-2">
          <span class="mt-0.5 text-warm" aria-hidden="true">●</span>
          <p>
            Rates are from PURC’s residential Fourth Schedule, effective 1 October 2026. This estimate applies the selected rate to dish use only; it excludes service charges, levies, and any household tier crossing.
            <a class="font-semibold text-ink underline underline-offset-2" href="https://purc.com.gh/attachment/67864-20261001121001.pdf" target="_blank" rel="noopener noreferrer">See the official tariff</a>.
          </p>
        </div>
      </form>

      <div class="grid content-start gap-4">
        <section class="relative overflow-hidden rounded-[22px] border border-rule bg-surface p-5 sm:p-7" aria-live="polite">
          <div class="flex items-center justify-between gap-3">
            <div class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-3">Estimated electricity</div>
            <span id="selected-rate" class="rounded-full bg-paper px-2.5 py-1 font-mono text-[10px] text-ink-2"></span>
          </div>
          <div id="monthly-total" class="mt-4 font-display text-[clamp(2.7rem,6vw,4.3rem)] leading-none font-bold tracking-[-0.04em] tabular-nums text-ink">—</div>
          <div class="mt-2 text-sm font-semibold text-ink-2">30-day electricity + optional plan</div>
          <div id="monthly-breakdown" class="mt-1 text-xs text-ink-3"></div>

          <div class="mt-7 grid gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-rule bg-paper p-4">
              <div class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-3">Per day</div>
              <div id="daily-cost" class="mt-2 text-xl font-bold tabular-nums">—</div>
              <div id="daily-kwh" class="mt-1 text-xs text-ink-3"></div>
            </div>
            <div class="rounded-2xl border border-rule bg-paper p-4">
              <div class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-3">7 days</div>
              <div id="weekly-cost" class="mt-2 text-xl font-bold tabular-nums">—</div>
              <div id="weekly-kwh" class="mt-1 text-xs text-ink-3"></div>
            </div>
            <div class="rounded-2xl border border-rule bg-paper p-4">
              <div class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-3">30 days</div>
              <div id="monthly-electricity" class="mt-2 text-xl font-bold tabular-nums">—</div>
              <div id="monthly-kwh" class="mt-1 text-xs text-ink-3"></div>
            </div>
          </div>
        </section>

        <section class="rounded-[22px] border border-rule bg-paper p-5 sm:p-6">
          <div class="flex items-start gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-surface font-mono font-semibold text-warm" aria-hidden="true">GH₵</div>
            <div>
              <h2 class="text-lg font-bold">See what your household uses</h2>
              <p class="mt-1 text-sm leading-relaxed text-ink-2">
                The connected Dishylink app can show measured daily, weekly and monthly energy, total download and upload, plus each router-connected device’s data share.
              </p>
              <a href="#dishylink" class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-ink underline decoration-warm underline-offset-4">
                How automatic detection works <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </section>
      </div>
    </section>

    <section id="dishylink" class="mx-auto mt-16 max-w-4xl border-t border-rule pt-10">
      <div class="grid gap-8 md:grid-cols-[0.7fr_1.3fr]">
        <div>
          <div class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-3">Live data, when connected</div>
          <h2 class="mt-2 font-display text-section font-bold">No guessing about your own dish.</h2>
        </div>
        <div class="space-y-4 text-base leading-relaxed text-ink-2">
          <p>
            Dishylink identifies supported hardware from the dish’s local hardware version. If its history recorder is running, electricity cost uses measured kWh instead of a Mini or Standard wattage estimate.
          </p>
          <p>
            Data totals are measured locally from dish throughput. Device percentages come from router counters, so they are shown as each device’s share of tracked router data rather than as a split of the dish’s billing meter.
          </p>
          <div class="flex flex-wrap gap-3 pt-1">
            <Button href="https://github.com/hayalows/starlink" variant="primary">
              <Icon name="github" />
              Explore the project
            </Button>
            <Button href="https://github.com/hayalows/starlink#readme" variant="secondary">
              Read setup instructions
            </Button>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-14 max-w-4xl rounded-[22px] border border-rule bg-surface p-5 sm:p-7">
      <div class="grid gap-5 md:grid-cols-3">
        <div>
          <div class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-3">1 · Choose</div>
          <h3 class="mt-2 font-bold">Pick Mini or Standard</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-2">The calculator uses Starlink’s published average power range and starts at 24 hours per day.</p>
        </div>
        <div>
          <div class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-3">2 · Set</div>
          <h3 class="mt-2 font-bold">Use your ECG band</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-2">Select the residential tariff that matches your meter. Dishylink uses the effective rate you choose.</p>
        </div>
        <div>
          <div class="font-mono text-[10px] uppercase tracking-[0.12em] text-ink-3">3 · Compare</div>
          <h3 class="mt-2 font-bold">Daily, weekly, monthly</h3>
          <p class="mt-1 text-sm leading-relaxed text-ink-2">Change powered hours or enter your plan charge to see how the household internet cost adds up.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto mt-12 max-w-4xl rounded-[22px] border border-rule p-5 sm:p-7">
      <p class="text-sm leading-relaxed text-ink-2">
        Power ranges use Starlink-published averages: Mini 25–40 W, Standard 4 75–100 W, and Standard V5 35–50 W. Actual use changes with weather, load, router or mesh equipment, and settings.
      </p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold">
        <a class="underline decoration-warm underline-offset-4" href="https://starlink.com/gd/support/article/5465736f-fa8d-3ac1-dd3a-7a259d12fa8d" target="_blank" rel="noopener noreferrer">Starlink Standard V4/V5 power spec</a>
        <a class="underline decoration-warm underline-offset-4" href="https://starlink.com/ua/mini-product-us" target="_blank" rel="noopener noreferrer">Starlink Mini specifications</a>
        <a class="underline decoration-warm underline-offset-4" href="https://purc.com.gh/attachment/67864-20261001121001.pdf" target="_blank" rel="noopener noreferrer">PURC residential rates</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const models = {
    mini: {
      label: "Starlink Mini",
      low: 25,
      high: 40,
      note: "Starlink publishes 25–40 W average for Mini. The estimate uses the midpoint, 32.5 W.",
    },
    standard4: {
      label: "Standard 4",
      low: 75,
      high: 100,
      note: "Starlink publishes 75–100 W average for Standard 4. The estimate uses the midpoint, 87.5 W.",
    },
    standard5: {
      label: "Standard V5",
      low: 35,
      high: 50,
      note: "Starlink publishes 35–50 W average for Standard V5. The estimate uses the midpoint, 42.5 W.",
    },
    custom: {
      label: "Your dish",
      low: 50,
      high: 50,
      note: "Your entered wattage is used as the average draw.",
    },
  };

  const modelSelect = document.querySelector("#dish-model");
  const customInput = document.querySelector("#custom-watts");
  const customWrap = document.querySelector("#custom-watts-wrap");
  const rateSelect = document.querySelector("#ecg-rate");
  const hoursInput = document.querySelector("#hours-per-day");
  const planInput = document.querySelector("#plan-fee");
  const assumption = document.querySelector("#model-assumption");

  function money(value) {
    return "GH₵" + new Intl.NumberFormat("en-GH", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(value);
  }

  function setText(id, value) {
    const element = document.getElementById(id);
    if (element) element.textContent = value;
  }

  function render() {
    if (!modelSelect || !rateSelect || !hoursInput || !planInput || !assumption || !customInput || !customWrap) return;

    const model = models[modelSelect.value] || models.mini;
    const hours = Math.max(1, Math.min(24, Number(hoursInput.value) || 24));
    const rate = Number(rateSelect.value) || 0;
    const watts = modelSelect.value === "custom"
      ? Math.max(1, Number(customInput.value) || 1)
      : (model.low + model.high) / 2;
    const dayKwh = (watts * hours) / 1000;
    const weekKwh = dayKwh * 7;
    const monthKwh = dayKwh * 30;
    const dayCost = dayKwh * rate;
    const weekCost = weekKwh * rate;
    const monthElectricity = monthKwh * rate;
    const plan = Math.max(0, Number(planInput.value) || 0);
    const monthTotal = monthElectricity + plan;

    customWrap.classList.toggle("hidden", modelSelect.value !== "custom");
    assumption.textContent = model.note;
    setText("selected-rate", "GH₵" + rate.toFixed(6) + " / kWh");
    setText("monthly-total", money(monthTotal));
    setText(
      "monthly-breakdown",
      money(monthElectricity) + " electricity" + (plan > 0 ? " + " + money(plan) + " plan" : " · plan price not added"),
    );
    setText("daily-cost", money(dayCost));
    setText("weekly-cost", money(weekCost));
    setText("monthly-electricity", money(monthElectricity));
    setText("daily-kwh", dayKwh.toFixed(2) + " kWh at " + watts.toFixed(1) + " W");
    setText("weekly-kwh", weekKwh.toFixed(2) + " kWh");
    setText("monthly-kwh", monthKwh.toFixed(2) + " kWh");
  }

  for (const input of [modelSelect, customInput, rateSelect, hoursInput, planInput]) {
    input?.addEventListener("input", render);
    input?.addEventListener("change", render);
  }

  render();
</script>
