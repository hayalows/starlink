---
import Base from "../layouts/Base.astro";
---
<Base title="My monitor — Starlink Ghana" description="Your paired Starlink internet dashboard. Usage, energy, costs, devices and connection details on your phone." path="/live/">
  <link slot="head" rel="stylesheet" href="/phone.css?v=153" />
  <link slot="head" rel="stylesheet" href="/phone-refine.css?v=153" />
  <link slot="head" rel="stylesheet" href="/phone-telemetry.css?v=162" />
  <link slot="head" rel="stylesheet" href="/phone-analytics.css?v=163" />
  <div class="phone-shell" id="phone-app">
    <header class="phone-top">
      <a href="/" class="phone-brand" aria-label="Starlink Ghana public website">
        <img class="phone-brand-icon" src="/icon-192.png" width="34" height="34" alt="" />
        <span>STARLINK<span class="phone-brand-small">/ GHANA</span></span>
      </a>
      <span class="phone-top-label"><span class="ui-icon ui-icon--signal-01" aria-hidden="true"></span> MY MONITOR</span>
      <button class="phone-icon-button" type="button" id="phone-refresh" title="Refresh saved readings" aria-label="Refresh saved readings"><span class="ui-icon ui-icon--refresh-cw-01" aria-hidden="true"></span></button>
    </header>
    <main class="phone-main">
      <section class="phone-pair" id="pair-section" aria-labelledby="pair-title">
        <div class="phone-eyebrow"><span class="phone-status-light"></span> CONNECT YOUR MONITOR</div>
        <h1 id="pair-title">Your internet, wherever you are.</h1>
        <p>Your site is open. Your household readings are private. Pair the extension on your laptop once to view them on your phone, without signing in.</p>
        <div class="phone-stepper" aria-label="Pairing steps">
          <div><span>01</span>Open the extension's Overview</div>
          <div><span>02</span>Choose Connect my phone</div>
          <div><span>03</span>Open your private link here</div>
        </div>
        <form id="pair-form" class="phone-pair-form">
          <label for="pair-code">Paste your private pairing link or code</label>
          <div class="phone-pair-row"><input id="pair-code" type="text" spellcheck="false" autocomplete="off" placeholder="Paste from your extension" required /><button type="submit" class="phone-button phone-button-primary">Connect ↗</button></div>
        </form>
        <p id="pair-feedback" class="phone-pair-feedback" role="status"></p>
        <p class="phone-pair-footer">Anyone with a copy of your private pairing link can read saved summaries. Disconnect it on the laptop to revoke access.</p>
      </section>

      <section id="monitor-section" class="phone-monitor" hidden>
        <div class="phone-heading-row">
          <div><div class="phone-eyebrow">YOUR STARLINK · GHANA</div><h1>Your internet<span class="phone-title-period">.</span></h1></div>
          <div id="sync-badge" class="phone-sync-badge" role="status">Checking…</div>
        </div>
        <p class="phone-sync-copy" id="sync-copy" aria-live="polite">Connecting to your last saved monitor reading…</p>
        <div class="phone-pair-form"><label for="recorder-select">Viewing recorder</label><select id="recorder-select" class="phone-button" aria-label="Viewing recorder"></select></div>
        <div id="legacy-notice" class="phone-legacy-notice" role="status" hidden></div>
        <nav class="phone-section-nav" aria-label="Monitor sections">
          <button type="button" data-view="overview" aria-current="page"><span class="ui-icon ui-icon--home-02" aria-hidden="true"></span>Overview</button>
          <button type="button" data-view="analytics"><span class="ui-icon ui-icon--bar-chart-02" aria-hidden="true"></span>Analytics</button>
          <button type="button" data-view="costs"><span class="ui-icon ui-icon--coins-01" aria-hidden="true"></span>Costs</button>
          <button type="button" data-view="devices"><span class="ui-icon ui-icon--layers-three-01" aria-hidden="true"></span>Devices</button>
          <button type="button" data-view="connection"><span class="ui-icon ui-icon--wifi" aria-hidden="true"></span>Connection</button>
        </nav>
        
        <section data-screen="overview" aria-label="Overview" class="phone-screen">
          <div class="phone-hero-metric">
            <div class="phone-hero-top"><span id="hero-period-label">Data recorded today</span><span class="phone-traffic-arrows" aria-label="Download and upload"><span class="ui-icon ui-icon--activity" aria-hidden="true"></span></span></div>
            <div class="phone-hero-number"><strong id="hero-gb">—</strong><span>GB</span></div>
            <div class="phone-hero-bottom"><span id="hero-coverage">Waiting for readings</span><button type="button" data-open="history">View history <span class="ui-icon ui-icon--arrow-up-right ui-icon--sm" aria-hidden="true"></span></button></div>
          </div>
          <section class="phone-stat-grid phone-overview-grid" aria-label="Your internet at a glance">
            <article class="phone-stat"><span class="phone-stat-label" id="today-cost-label">ESTIMATED COST TODAY</span><strong id="overview-today-cost">—</strong><small>Plan time share + electricity</small></article>
            <article class="phone-stat"><span class="phone-stat-label">MONTH-END ESTIMATE</span><strong id="metric-cost">—</strong><small id="metric-cost-note">Plan + projected electricity</small></article>
            <article class="phone-stat"><span class="phone-stat-label">DATA THIS MONTH</span><strong id="overview-month-gb">—</strong><small>Measured download + upload</small></article>
            <article class="phone-stat"><span class="phone-stat-label">ENERGY THIS MONTH</span><strong id="metric-energy">—</strong><small id="metric-energy-note">Recorded kWh · gaps excluded</small></article>
          </section>
          <section class="phone-panel phone-chart-panel" id="history">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">NETWORK TRAFFIC</span><h2>Usage over time</h2></div><span class="phone-chart-unit">GB</span></div>
            <div class="phone-tabs" role="tablist" aria-label="Usage period">
              <button type="button" class="selected" data-period="today" role="tab" aria-selected="true">Today</button>
              <button type="button" data-period="week" role="tab" aria-selected="false">7 days</button>
              <button type="button" data-period="month" role="tab" aria-selected="false">Month</button>
              <button type="button" data-period="cycle" role="tab" aria-selected="false">Billing cycle</button>
            </div>
            <div id="chart-summary" class="phone-chart-summary">Waiting for measurements</div>
            <div class="phone-chart-scroll"><div id="phone-chart" class="phone-chart" role="img" aria-label="Recorded download and upload usage chart"></div></div>
            <div id="chart-point-detail" class="phone-chart-point" role="status" aria-live="polite">Tap a bar to view recorded download, upload and energy.</div>
            <p id="chart-insight" class="phone-fine"></p>
            <div class="phone-chart-foot"><span><i class="phone-legend-live"></i> Recorded</span><span><i class="phone-legend-gap"></i> No reading / gap</span></div>
          </section>
          <section class="phone-panel phone-telemetry-panel" aria-labelledby="traffic-detail-title">
            <div class="phone-panel-head">
              <div><span class="phone-eyebrow">MEASUREMENTS · <span id="measurement-period-title">TODAY</span></span><h2 id="traffic-detail-title">Where the data went</h2></div>
              <span class="phone-chart-unit">DOWNLOAD + UPLOAD</span>
            </div>
            <div class="phone-measure-grid">
              <div class="phone-measure"><span>Downloaded</span><strong id="measure-download">—</strong><small>In recorded chart buckets</small></div>
              <div class="phone-measure"><span>Uploaded</span><strong id="measure-upload">—</strong><small>In recorded chart buckets</small></div>
              <div class="phone-measure"><span>Average usage</span><strong id="measure-rate">—</strong><small>GB per recorded hour</small></div>
              <div class="phone-measure"><span>Traffic observed</span><strong id="measure-hours">—</strong><small>Hours with valid traffic</small></div>
            </div>
            <p id="measure-guidance" class="phone-fine phone-info-line" role="status">Measurements will appear after your recorder uploads them.</p>
          </section>
          <section class="phone-panel phone-history">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">DAILY JOURNAL</span><h2>Your recent days</h2></div><span class="phone-chart-unit">HISTORY</span></div>
            <div id="phone-day-list" class="phone-day-list"></div>
          </section>
        </section>


        <section data-screen="analytics" aria-label="Analytics" class="phone-screen" hidden>
          <div class="phone-screen-heading analytics-intro">
            <div class="phone-eyebrow">YOUR ACTUAL RECORDINGS</div>
            <h2>Explore your data<span class="phone-title-period">.</span></h2>
            <p>Find your busiest times, compare download and upload, and inspect any day. Gaps are never counted as zero use.</p>
          </div>
          <section class="phone-panel analytics-filter-panel" aria-label="Analytics filters">
            <div class="phone-panel-head analytics-topline">
              <div><span class="phone-eyebrow">TIME RANGE</span><h2>When would you like to look?</h2></div>
              <span class="phone-chart-unit">GMT · GHANA</span>
            </div>
            <div class="analytics-presets" role="group" aria-label="Date presets">
              <button type="button" data-analysis-range="today">Today</button>
              <button type="button" data-analysis-range="7d" class="is-active" aria-pressed="true">7 days</button>
              <button type="button" data-analysis-range="30d">30 days</button>
              <button type="button" data-analysis-range="month">This month</button>
              <button type="button" data-analysis-range="all">All time</button>
              <button type="button" data-analysis-range="custom">Custom dates</button>
            </div>
            <form class="analytics-custom" id="analytics-custom" hidden>
              <label>From<input id="analytics-from" type="date" required /></label>
              <label>To<input id="analytics-to" type="date" required /></label>
              <button class="analytics-apply" type="submit">Apply range</button>
            </form>
            <p id="analytics-scope" class="analytics-scope" aria-live="polite">Choose a time range to explore saved measurements.</p>
          </section>
          <section class="analytics-summary-grid" aria-label="Selected range totals">
            <button class="analytics-summary-tile is-active" type="button" data-analysis-metric="total" aria-pressed="true"><span>Total data</span><strong id="analytics-total">—</strong><small>Recorded GB</small></button>
            <button class="analytics-summary-tile" type="button" data-analysis-metric="down" aria-pressed="false"><span>Downloaded</span><strong id="analytics-down">—</strong><small>Recorded GB</small></button>
            <button class="analytics-summary-tile" type="button" data-analysis-metric="up" aria-pressed="false"><span>Uploaded</span><strong id="analytics-up">—</strong><small>Recorded GB</small></button>
            <button class="analytics-summary-tile" type="button" data-analysis-metric="energy" aria-pressed="false"><span>Dish energy</span><strong id="analytics-energy">—</strong><small>Recorded kWh</small></button>
          </section>
          <section class="phone-panel analytics-graph-panel" aria-labelledby="analytics-trend-title">
            <div class="phone-panel-head analytics-graph-header">
              <div><span class="phone-eyebrow">USAGE OVER TIME</span><h2 id="analytics-trend-title">Recorded data trend</h2></div>
              <span class="analytics-granularity" id="analytics-grain-label">DAILY</span>
            </div>
            <div id="analytics-graph-summary" class="analytics-graph-summary" aria-live="polite">Loading recorded history…</div>
            <div id="analytics-graph" class="analytics-graph" role="group" aria-label="Interactive recorded usage trend"></div>
            <div class="analytics-graph-legend"><span><i></i> Recorded</span><span><i></i> Missing observation</span></div>
            <div id="analytics-point" class="analytics-point" role="status" aria-live="polite">Tap or focus a chart point to see the exact recorded usage.</div>
            <div class="analytics-drill-tools">
              <button type="button" id="analytics-back" hidden>← Back to date range</button>
              <span id="analytics-chart-help">Tap a day to inspect its hourly activity.</span>
            </div>
          </section>
          <section class="analytics-detail-grid" aria-label="Analysis highlights">
            <article class="phone-panel analytics-insight">
              <div class="phone-eyebrow">RECORDING QUALITY</div>
              <strong id="analytics-coverage">—</strong>
              <p id="analytics-coverage-note">Time with stored measurements in the selected range.</p>
            </article>
            <article class="phone-panel analytics-insight">
              <div class="phone-eyebrow">BUSIEST RECORDED HOUR</div>
              <strong id="analytics-peak">—</strong>
              <p id="analytics-peak-note">Peak within this selection.</p>
            </article>
          </section>
          <section class="phone-panel analytics-breakdown" aria-label="Traffic composition">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">DATA FLOW</span><h2>Download versus upload</h2></div></div>
            <div class="analytics-mix" id="analytics-mix" role="img" aria-label="Download and upload proportions"><span class="analytics-mix-down"></span><span class="analytics-mix-up"></span></div>
            <div class="analytics-mix-labels"><span id="analytics-down-share">Download —</span><span id="analytics-up-share">Upload —</span></div>
            <p class="phone-fine">This is dish-wide WAN traffic, not per-device attribution. A blank period means no saved reading.</p>
          </section>
          <section class="phone-panel analytics-history-panel" aria-labelledby="analytics-history-title">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">DETAIL BY PERIOD</span><h2 id="analytics-history-title">Your recorded days</h2></div></div>
            <p class="phone-fine">Select a row for the recorded data, energy and completeness. Select a day to explore each hour.</p>
            <div id="analytics-history" class="analytics-history" role="list"></div>
          </section>
          <p id="analytics-message" class="analytics-message" role="status" aria-live="polite">Private history stays protected by your existing pairing code. Analytics refreshes when new readings have been uploaded.</p>
        </section>

        <section data-screen="costs" aria-label="Costs" class="phone-screen" hidden>
          <div class="phone-screen-heading"><div class="phone-eyebrow">CEDIS & DATA</div><h2>Understand your costs</h2><p>Your Starlink fee is fixed. Your effective cost per gigabyte changes as you record more data.</p></div>
          <section class="phone-panel">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">COST CLARITY</span><h2>Cost for <span id="cost-period-label">today so far</span></h2></div><span class="phone-tiny-icon"><span class="ui-icon ui-icon--wallet-02" aria-hidden="true"></span></span></div>
            <div class="phone-tabs phone-cost-tabs" role="tablist" aria-label="Cost period">
              <button type="button" class="selected" data-period="today" role="tab" aria-selected="true">Today</button>
              <button type="button" data-period="week" role="tab" aria-selected="false">7 days</button>
              <button type="button" data-period="month" role="tab" aria-selected="false">Month</button>
              <button type="button" data-period="cycle" role="tab" aria-selected="false">Billing cycle</button>
            </div>
            <div class="phone-cost-line"><span>Plan time share</span><strong id="cost-plan">—</strong></div>
            <div class="phone-cost-line"><span>Electricity estimate so far</span><strong id="cost-electricity">—</strong></div>
            <div class="phone-cost-line phone-cost-total"><span>Combined period estimate</span><strong id="cost-total">—</strong></div>
            <p class="phone-fine">Your full monthly subscription: <strong id="plan-full">—</strong>. This is an estimated spending allocation, not a Starlink or ECG invoice.</p>
          </section>
          <section class="phone-panel" id="data-value">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">DATA VALUE</span><h2>How much does each GB cost?</h2></div><span class="phone-tiny-icon"><span class="ui-icon ui-icon--bar-chart-02" aria-hidden="true"></span></span></div>
            <div class="phone-stat-grid">
              <article class="phone-stat"><span class="phone-stat-label">EFFECTIVE STARLINK GH₵ / GB</span><strong id="starlink-per-gb">—</strong><small id="starlink-rate-note">Full-month estimate ÷ GB recorded so far</small></article>
              <article class="phone-stat"><span class="phone-stat-label">GB PER GH₵</span><strong id="starlink-gb-per-cedi">—</strong><small>Recorded download + upload ÷ estimated full-month cedis</small></article>
            </div>
            <p class="phone-fine" id="value-coverage-note">The figure starts with your first recorded GB and improves as you use more data, provided your estimated monthly cost stays similar.</p>
            <div class="phone-cost-line"><span>Saved mobile bundle</span><strong id="bundle-title">—</strong></div>
            <div class="phone-cost-line"><span>Mobile bundle GH₵ / GB</span><strong id="bundle-per-gb">—</strong></div>
            <p id="break-even-note" class="phone-fine"></p>
            <p id="bundle-comparison" class="phone-fine">Set a mobile bundle price and GB in your laptop's Costs settings if you want to compare.</p>
          </section>
          <section class="phone-panel phone-telemetry-panel" aria-labelledby="power-detail-title">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">PLAN AHEAD</span><h2 id="power-detail-title">Energy and data forecast</h2></div><span class="phone-chart-unit">ESTIMATES</span></div>
            <div class="phone-measure-grid">
              <div class="phone-measure"><span>Measured energy</span><strong id="cost-month-kwh">—</strong><small>Recorded this month</small></div>
              <div class="phone-measure"><span>Month-end electricity</span><strong id="cost-month-power">—</strong><small>Projected dish electricity</small></div>
              <div class="phone-measure"><span>Month-end data</span><strong id="cost-month-data">—</strong><small>Projection from observed traffic</small></div>
              <div class="phone-measure"><span>Traffic coverage</span><strong id="cost-month-coverage">—</strong><small>Elapsed month sampled</small></div>
            </div>
            <p id="cost-forecast-guidance" class="phone-fine phone-info-line">A projection is not a bill or a guarantee of future use.</p>
          </section>
        </section>

        <section data-screen="devices" aria-label="Devices" class="phone-screen" hidden>
          <div class="phone-screen-heading"><div class="phone-eyebrow">CONNECTED HOUSEHOLD</div><h2>Who uses the most?</h2><p>Device shares are based on router counters—not the separate dish-wide traffic meter.</p></div>
          <section class="phone-device-overview" aria-label="Device summary">
            <div><span>Router-counted data</span><strong id="devices-total">—</strong><small>This month, separate meter</small></div>
            <div><span>Largest recorded share</span><strong id="devices-leader">—</strong><small id="devices-leader-note">Waiting for device totals</small></div>
          </section>
          <section class="phone-panel" id="device-shares">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">HOUSEHOLD MIX</span><h2>Usage by device</h2></div><span class="phone-chart-unit"><span class="ui-icon ui-icon--layers-three-01" aria-hidden="true"></span> ROUTER TOTALS</span></div>
            <p class="phone-chart-summary" id="device-summary">Waiting for synced device totals.</p>
            <div id="phone-device-list" class="phone-device-list"></div>
            <p class="phone-fine">Devices may reconnect or reset their counters. Percentages describe known devices, and may not add up to total Starlink traffic.</p>
          </section>
        </section>

        <section data-screen="connection" aria-label="Connection" class="phone-screen" hidden>
          <div class="phone-screen-heading"><div class="phone-eyebrow">REMOTE STATUS</div><h2>Connection & sync</h2><p>Your phone reads saved history. The recording computer must stay awake with Chrome running to collect new readings.</p></div>
          <section class="phone-panel phone-recorder-panel">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">COLLECTOR</span><h2>Recording health</h2></div><span id="recorder-icon" class="phone-recorder-icon"><span class="ui-icon ui-icon--activity" aria-hidden="true"></span></span></div>
            <div class="phone-cost-line"><span>Recorder</span><strong id="recorder-name">Computer recorder</strong></div>
            <div class="phone-cost-line"><span>Last reading</span><strong id="last-reading">—</strong></div>
            <div class="phone-cost-line"><span>Last upload</span><strong id="last-upload">—</strong></div>
            <div class="phone-cost-line"><span>Today's coverage</span><strong id="today-coverage">—</strong></div>
            <p class="phone-fine" id="recorder-description">Your laptop records while Chrome runs. A previous reading is not a live signal.</p>
          </section>
          <details class="phone-panel phone-telemetry-details">
            <summary>Advanced recorder measurements <span aria-hidden="true">+</span></summary>
            <p class="phone-fine">These readings come from your selected computer's last upload. A missing value means unknown, not zero.</p>
            <div id="phone-recording-details-list" class="phone-measure-list"></div>
            <p class="phone-fine">Device counters and dish-wide usage are different meters. The PWA cannot measure live internet speed while the recorder is offline.</p>
          </details>
          <section class="phone-panel" aria-label="Download history backup">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">HISTORY SAFETY</span><h2>Your recovery copy</h2></div><span class="phone-chart-unit"><span class="ui-icon ui-icon--shield-01" aria-hidden="true"></span> VAULT</span></div>
            <p class="phone-fine">If you enable History vault in the desktop extension, your paired phone can download a complete backup of archived minute readings. Keep it outside Chrome to protect against browser storage loss.</p>
            <p id="phone-vault-status" class="phone-fine" role="status">Checking archived history…</p>
            <button class="phone-button phone-button-primary" type="button" id="download-vault" disabled><span class="ui-icon ui-icon--download-01" aria-hidden="true"></span> Download archived minutes</button>
          </section>
          <section class="phone-panel">
            <div class="phone-panel-head"><div><span class="phone-eyebrow">YOUR PHONE</span><h2>Install the app</h2></div><span class="phone-chart-unit"><span class="ui-icon ui-icon--monitor-01" aria-hidden="true"></span> PWA</span></div>
            <p class="phone-fine">Add this monitor to your home screen for a standalone, app-like experience. No App Store or account required.</p>
            <button class="phone-button phone-button-primary phone-install-button" type="button" id="install-phone"><span class="ui-icon ui-icon--download-01" aria-hidden="true"></span> <span class="install-label">How to install</span></button>
            <p id="install-instructions" class="phone-fine" role="status">On iPhone, open this page in Safari, tap Share, then Add to Home Screen.</p>
            <p class="phone-fine">The app shell can open offline, but fresh readings still require a network connection. This phone never silently collects dish data.</p>
          </section>
          <section class="phone-settings">
            <button id="add-monitor" type="button">Add another computer</button>
            <button id="forget-monitor" type="button">Forget this monitor on this phone</button>
            <a href="/">Public cost calculator ↗</a>
          </section>
        </section>
      </section>
    </main>
    <footer class="phone-footer"><span>STARLINK GHANA · INDEPENDENT TOOL</span><span>Made by <a href="https://pkm.hayalows.com" rel="noopener noreferrer" target="_blank">Papa Kojo Mensah ↗</a> · Not affiliated with Starlink or SpaceX.</span></footer>
    <nav class="phone-bottom-nav" id="phone-bottom-nav" aria-label="Mobile monitor navigation" hidden>
      <button type="button" data-view="overview"><span aria-hidden="true"><span class="ui-icon ui-icon--home-02" aria-hidden="true"></span></span>Overview</button>
      <button type="button" data-view="analytics"><span aria-hidden="true"><span class="ui-icon ui-icon--bar-chart-02" aria-hidden="true"></span></span>Analytics</button>
      <button type="button" data-view="costs"><span aria-hidden="true"><span class="ui-icon ui-icon--coins-01" aria-hidden="true"></span></span>Costs</button>
      <button type="button" data-view="devices"><span aria-hidden="true"><span class="ui-icon ui-icon--layers-three-01" aria-hidden="true"></span></span>Devices</button>
      <button type="button" data-view="connection"><span aria-hidden="true"><span class="ui-icon ui-icon--wifi" aria-hidden="true"></span></span>Connection</button>
    </nav>
  </div>
  <script type="module" is:inline src="/phone.js?v=163"></script>
  <script type="module" is:inline src="/phone-analytics.js?v=163"></script>
</Base>
