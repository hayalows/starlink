---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = "/" } = Astro.props;
const isPhone = path.startsWith("/live/");
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://starlink-ghana.vercel.app";
const canonical = new URL(path, site).toString();
const ogImage = new URL("/og.png", site).toString();
const orgId = `${site}/#organization`;
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": orgId,
  name: "Starlink Ghana",
  url: site,
  description: "Independent tools for understanding Starlink electricity costs, energy use and household data in Ghana. Not affiliated with SpaceX or Starlink.",
};
const app = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Starlink Ghana Monitor",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web, Android, iOS, desktop",
  description,
  url: canonical,
  isAccessibleForFree: true,
  publisher: { "@id": orgId },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={isPhone ? "#080b0d" : "#13251e"} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content={isPhone ? "black-translucent" : "black"} />
    <meta name="apple-mobile-web-app-title" content={isPhone ? "My Starlink" : "Starlink Ghana"} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPhone && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href={isPhone ? "/live/manifest.webmanifest" : "/manifest.webmanifest"} />
    <link rel="stylesheet" href="/ui-icons.css?v=153" />
    <link rel="icon" href="/starlink-mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Starlink Ghana" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Starlink Ghana local-first energy and data monitor." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline set:html={JSON.stringify(organization)} type="application/ld+json" />
    <script is:inline set:html={JSON.stringify(app)} type="application/ld+json" />
  </head>
  <body class="bg-paper text-ink antialiased">
    <slot />
  </body>
</html>
